@model ContentDetailViewModel
@{
    ViewData["Title"] = Model.Content.Title;
    var c = Model.Content;
    var crumbs = new List<BreadcrumbItem> { new("Explore", "/Explore"), new(c.Title) };
}

<partial name="_Breadcrumbs" model="crumbs" />

<div class="row g-4 mb-4">
    @* ---------------- Cover / media ---------------- *@
    <div class="col-lg-7">
        @if (Model.Media.FirstOrDefault() is { } firstMedia)
        {
            <div class="media-embed shadow-sm">
                <iframe src="@firstMedia.EmbedUrl" title="@firstMedia.Tag"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen></iframe>
            </div>
        }
        else if (!string.IsNullOrEmpty(c.ThumbnailUrl))
        {
            <img src="@c.ThumbnailUrl" alt="@c.Title" class="img-fluid rounded shadow-sm w-100" style="max-height:420px;object-fit:cover;" />
        }
        else
        {
            <div class="cover-fallback rounded shadow-sm" style="height:340px;">@c.Title</div>
        }

        @* Additional media embeds (trailers / audio) *@
        @if (Model.Media.Count > 1)
        {
            <div class="mt-3">
                <h2 class="section-title h6 mb-2">More media</h2>
                <div class="row g-2">
                    @foreach (var m in Model.Media.Skip(1))
                    {
                        <div class="col-6">
                            <a href="@m.EmbedUrl" target="_blank" rel="noopener"
                               class="btn btn-outline-secondary btn-sm w-100 text-start">
                                @m.MediaType @(m.Tag is { Length: > 0 } ? "· " + m.Tag : "") ↗
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @* ---------------- Info + rating + bookmark ---------------- *@
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <h1 class="h3 page-title mb-1">@c.Title</h1>
                    <span class="badge badge-type rounded-pill">@c.Type</span>
                </div>
                <div class="text-muted small mb-2">
                    📂 @c.Category.Name
                    @(c.Genre is { Length: > 0 } ? " · 🎭 " + c.Genre : "")
                    @(c.ReleaseDate is not null ? " · 📅 " + c.ReleaseDate.Value.ToString("MMM d, yyyy") : "")
                </div>

                <div class="d-flex gap-3 small text-muted mb-3">
                    <span>👁 @c.ViewCount views</span>
                    <span>🔥 popularity @c.PopularityScore</span>
                </div>

                <p>@c.Description</p>

                @* ---- Tags ---- *@
                @if (c.ContentTags.Count > 0)
                {
                    <div class="mb-3">
                        @foreach (var ct in c.ContentTags)
                        {
                            <span class="tag-chip me-1">@ct.Tag.Name</span>
                        }
                    </div>
                }

                @* ---- Star rating widget (AJAX) ---- *@
                <hr />
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="small text-muted mb-1">Your rating</div>
                        <div class="star-rating" id="ratingWidget"
                             data-content-id="@c.ContentId" data-my-stars="@(Model.MyStars ?? 0)">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <span class="star @(Model.MyStars >= i ? "on" : "")" data-star="@i" title="@i star(s)">★</span>
                            }
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="rating-summary h4 mb-0"><span id="ratingAvg">@Model.AverageRating</span> / 5</div>
                        <div class="small text-muted" id="ratingCount">(@Model.RatingCount ratings)</div>
                    </div>
                </div>

                @* ---- Bookmark (AJAX) ---- *@
                <button type="button"
                        class="btn btn-outline-danger w-100 mt-3 bookmark-btn @(Model.IsBookmarked ? "active" : "")"
                        data-type="@((int)BookmarkType.Content)" data-id="@c.ContentId">
                    @(Model.IsBookmarked ? "♥ Bookmarked" : "♡ Bookmark")
                </button>
            </div>
        </div>
    </div>
</div>

@* ---------------- Related ---------------- *@
@if (Model.Related.Count > 0)
{
    <h2 class="section-title h5 mb-3">Related in @c.Category.Name</h2>
    <div class="row g-3">
        @foreach (var r in Model.Related)
        {
            <div class="col-6 col-md-3">
                <partial name="_ContentCard" model="r" />
            </div>
        }
    </div>
}
