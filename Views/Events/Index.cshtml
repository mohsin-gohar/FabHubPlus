@model EventsViewModel
@{
    ViewData["Title"] = "Events";
    var crumbs = new List<BreadcrumbItem> { new("Events") };
}

<partial name="_Breadcrumbs" model="crumbs" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title h3 mb-0">📅 Fandom events</h1>
    <span class="text-muted small">@Model.Items.Count event(s)</span>
</div>

@* ---- Filters ---- *@
<form method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">City</label>
                <select name="city" class="form-select">
                    <option value="">All cities</option>
                    @foreach (var c in Model.Cities)
                    {
                        <option value="@c" selected="@(Model.City == c ? "selected" : null)">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" name="past" value="true" id="pastCheck"
                           checked="@(Model.Past ? "checked" : null)" />
                    <label class="form-check-label" for="pastCheck">Show past events instead of upcoming</label>
                </div>
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-primary" type="submit">Apply</button>
            </div>
        </div>
    </div>
</form>

<div class="row g-4 mb-4">
    @* ---- Leaflet map (CDN) ---- *@
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="card-body p-0">
                <div id="eventMap" style="height:420px;background:var(--fhp-surface-2);"></div>
            </div>
        </div>
        <div class="form-text">Map pins show upcoming events (source: /Events/Feed JSON).</div>
    </div>

    @* ---- Event list ---- *@
    <div class="col-lg-5">
        <div class="list-group shadow-sm" style="max-height:460px;overflow-y:auto;">
            @foreach (var e in Model.Items)
            {
                <div class="list-group-item py-3">
                    <div class="d-flex w-100 justify-content-between">
                        <h2 class="h6 mb-1">@e.Title</h2>
                        <span class="badge bg-primary rounded-pill">@e.EventDate.ToString("MMM d, yyyy")</span>
                    </div>
                    <div class="small text-muted mb-1">📍 @e.City @(e.Type is { Length: > 0 } ? "· " + e.Type : "")</div>
                    @if (!string.IsNullOrEmpty(e.Story))
                    {
                        <p class="small mb-1">@e.Story</p>
                    }
                    @if (!string.IsNullOrEmpty(e.TicketUrl))
                    {
                        <a href="@e.TicketUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">Tickets ↗</a>
                    }
                </div>
            }
            @if (Model.Items.Count == 0)
            {
                <div class="list-group-item empty-state">No events for this filter.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @* Leaflet from CDN (only used on this page) *@
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function () {
            var map = L.map('eventMap').setView([20, 0], 2);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            fetch('/Events/Feed')
                .then(function (r) { return r.json(); })
                .then(function (events) {
                    events.forEach(function (e) {
                        if (!e.lat && !e.lng) return;
                        L.marker([e.lat, e.lng]).addTo(map)
                            .bindPopup('<strong>' + e.title + '</strong><br>' + e.city + '<br>' + e.date);
                    });
                    if (events.length) {
                        var group = new L.featureGroup(events.map(function (e) { return L.marker([e.lat, e.lng]); }));
                        map.fitBounds(group.getBounds().pad(0.2));
                    }
                });
        })();
    </script>
}
