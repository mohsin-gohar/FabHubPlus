                    <span class="font-secondary !font-extrabold uppercase tracking-[0.1em] text-lg md:text-xl text-white leading-none block">
                        Fan<span class="text-secondary">Hub</span>Plus
                    </span>
                </a>
                <div class="flex-none lg:hidden">
                    <button
                        type="button"
                        id="navbarBurgerToggle"
                        class="navbar-burger-toggle inline-block leading-none"
                    >
                        <span class="h-[3px] w-[30px] my-[5px] block bg-white"></span>
                        <span class="h-[3px] w-[30px] my-[5px] block bg-white"></span>
                        <span class="h-[3px] w-[30px] my-[5px] block bg-white"></span>
                    </button>
                </div>
                <div class="hidden lg:flex items-center grow basis-full basis-auto">
                    <ul class="navbar-nav flex items-center flex-row gap-[30px] xl:gap-[40px] 2xl:gap-[50px] mx-auto">
                        <li class="nav-item relative">
                            <a asp-controller="Explore" asp-action="Index" class="@NavLink("explore")">Explore</a>
                        </li>
                        <li class="nav-item relative">
                            <a asp-controller="Characters" asp-action="Index" class="@NavLink("characters")">Characters</a>
                        </li>
                        <li class="nav-item relative">
                            <a asp-controller="News" asp-action="Index" class="@NavLink("news")">News</a>
                        </li>
                        <li class="nav-item relative">
                            <a asp-controller="Events" asp-action="Index" class="@NavLink("events")">Events</a>
                        </li>
                        <li class="nav-item relative">
                            <a asp-controller="Merch" asp-action="Index" class="@NavLink("merch")">Merch</a>
                        </li>
                        <li class="nav-item relative">
                            <a asp-controller="FanArt" asp-action="Index" class="@NavLink("fanart")">Fan Art</a>
                        </li>
                        <li class="nav-item relative">
                            <a asp-controller="Support" asp-action="Index" class="@NavLink("support")">Support</a>
                        </li>
                    </ul>
                    <div class="flex items-center gap-[25px] xl:gap-[35px]">
                        <div class="flex items-center gap-[13px]">
                            <div class="relative">
                                <button
                                    type="button"
                                    id="searchBtn"
                                    class="text-xl relative inline-block text-white transition-all duration-300 ease-in-out hover:text-secondary"
                                >
                                    <i class="ri-search-line"></i>
                                </button>
                                <div
                                    id="searchBox"
                                    class="absolute mt-[28px] xl:mt-[36px] top-full ltr:right-0 rtl:left-0 w-[380px] xl:w-[420px] bg-black p-[25px] xl:p-[30px] invisible opacity-0 transition-all duration-300 ease-in-out"
                                >
                                    <form asp-controller="Explore" asp-action="Index" method="get" class="relative">
                                        <input type="text" name="search" class="form-input" placeholder="Search for anything" />
                                        <button
                                            class="absolute top-1/2 -translate-y-1/2 ltr:right-[20px] rtl:left-[20px] text-xl leading-none transition-all duration-300 ease-in-out hover:text-primary"
                                            type="submit"
                                        >
                                            <i class="ri-search-line"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div class="w-px bg-white/20 h-[20px]"></div>

                            @if (isAuth)
                            {
                                <ul class="navbar-nav flex items-center flex-row">
                                    <li class="nav-item relative">
                                        <a
                                            href="javascript:void(0);"
                                            class="nav-link dropdown-toggle font-bold text-15 relative py-[30px] xl:py-[40px] flex items-center gap-[10px] text-white transition-all duration-300 ease-in-out hover:text-secondary"
                                        >
                                            <i class="ri-user-3-line text-xl"></i>
                                            <span class="hidden xl:!inline-block">@(userName.Length > 14 ? userName[..14] + "…" : userName)</span>
                                        </a>
                                        <ul class="dropdown-menu absolute min-w-[270px] xl:min-w-[290px] bg-navy-black py-[25px] transition-all duration-300 ease-in-out">
                                            <li class="nav-item relative mb-[17px] last:mb-0">
                                                <a asp-controller="Account" asp-action="Profile" class="@DropLink("account")">
                                                    <i class="ri-user-3-line"></i> Profile &amp; settings
                                                </a>
                                            </li>
                                            <li class="nav-item relative mb-[17px] last:mb-0">
                                                <a asp-controller="Bookmarks" asp-action="Index" class="@DropLink("bookmarks")">
                                                    <i class="ri-heart-3-line"></i> My bookmarks
                                                </a>
                                            </li>
                                            <li class="nav-item relative mb-[17px] last:mb-0">
                                                <a asp-controller="FanArt" asp-action="Index" class="@DropLink("fanart")">
                                                    <i class="ri-palette-line"></i> My submissions
                                                </a>
                                            </li>
                                            <li class="nav-item relative mb-[17px] last:mb-0">
                                                <a asp-controller="Chatbot" asp-action="Index" class="@DropLink("chatbot")">
                                                    <i class="ri-question-answer-line"></i> Chat history
                                                </a>
                                            </li>
                                            @if (isAdmin)
                                            {
                                                <li class="nav-item relative mb-[17px] last:mb-0">
                                                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@DropLink("dashboard")">
                                                        <i class="ri-settings-3-line"></i> Admin dashboard
                                                    </a>
                                                </li>
                                            }
                                            <li class="nav-item relative">
                                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                                    <button
                                                        type="submit"
                                                        class="nav-link font-bold text-15 relative text-white px-[25px] block w-full transition-all duration-300 ease-in-out hover:text-secondary"
                                                        style="text-align: left;"
                                                    >
                                                        <i class="ri-logout-box-r-line"></i> Sign out
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="text-xl relative inline-block text-white transition-all duration-300 ease-in-out hover:text-secondary">
                                    <i class="ri-user-3-line"></i>
                                </a>
                            }
                        </div>

                        @if (isAuth)
                        {
                            <a asp-controller="Bookmarks" asp-action="Index" class="primary-btn !hidden xl:!inline-block">
                                <span><i class="ri-heart-3-line"></i> My List</span>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="primary-btn !hidden xl:!inline-block">
                                Sign In
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
