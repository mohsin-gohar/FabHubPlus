@* Reusable content card used by Home + Explorer grids (Misao theme style) *@
@model FanHubPlus.Models.Entities.Content
@{
    var categoryName = Model.Category?.Name ?? "Uncategorized";
    var description = Model.Description ?? string.Empty;
    var descriptionPreview = description.Length > 90 ? description[..90] + "…" : description;
}

<div class="fhp-card overflow-hidden">
    <a asp-controller="Explore" asp-action="Details" asp-route-id="@Model.ContentId" class="fhp-thumb">
        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
        {
            <img src="@Model.ThumbnailUrl" class="fhp-cover fhp-zoom" alt="@Model.Title" />
        }
        else
        {
            <div class="fhp-cover-fallback">@Model.Title</div>
        }
        <span class="fhp-badge fhp-badge-type">@Model.Type</span>
        <span class="fhp-badge fhp-badge-views"><i class="ri-eye-line"></i> @Model.ViewCount</span>
    </a>
    <div class="p-[20px] text-center">
        <h3 class="fhp-title text-base leading-none mb-[10px]">
            <a asp-controller="Explore" asp-action="Details" asp-route-id="@Model.ContentId">@Model.Title</a>
        </h3>
        <p class="text-13 text-body/70 mb-[10px]">
            @categoryName@(Model.Genre is { Length: > 0 } ? " · " + Model.Genre : "")
        </p>
        <p class="text-13 text-body/70 mb-[15px]">@descriptionPreview</p>
        <a asp-controller="Explore" asp-action="Details" asp-route-id="@Model.ContentId" class="primary-btn block w-full">
            <span>Open <i class="ri-arrow-right-line"></i></span>
        </a>
    </div>
</div>
