@model SitemapViewModel
@{
    ViewData["Title"] = "Sitemap";
    var crumbs = new List<BreadcrumbItem> { new("Sitemap") };
}

<partial name="_Breadcrumbs" model="crumbs" />

<h1 class="page-title h3 mb-1">🗺 Sitemap</h1>
<p class="text-muted small mb-4">
    Every page of the portal, generated live from the database.
    Search engines can also consume the machine-readable <a asp-action="Xml">sitemap.xml</a>.
</p>

<div class="row g-4">
    @foreach (var section_ in Model.Sections)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h6 section-title mb-2">
                        <a href="@section_.Url">@section_.Title</a>
                    </h2>
                    <ul class="list-unstyled small mb-0" style="columns:2;">
                        @foreach (var link in section_.Children)
                        {
                            <li class="mb-1"><a href="@link.Url">@link.Title</a></li>
                        }
                        @if (section_.Children.Count == 0)
                        {
                            <li class="text-muted">—</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
</div>
