@model NewsViewModel
@{
    ViewData["Title"] = "News & Timeline";
    var showTimeline = Model.IsTimeline == true;
}

<partial name="_Breadcrumbs" model="new List<BreadcrumbItem> { new(\"News & Timeline\") }" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title h3 mb-0">@(showTimeline ? "🕰 Fandom timeline" : "📰 News & stories")</h1>
</div>

@* ---- Tabs: News / Timeline / category filter ---- *@
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(!showTimeline && Model.IsTimeline is null or false ? "active" : "")"
           asp-action="Index">News</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(showTimeline ? "active" : "")"
           asp-action="Index" asp-route-timeline="true">Timeline</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.IsTimeline is null ? "active" : "")"
           asp-action="Index">All</a>
    </li>
</ul>

<form method="get" class="row g-2 mb-4">
    @if (Model.IsTimeline is not null)
    {
        <input type="hidden" name="timeline" value="@Model.IsTimeline.ToString()" />
    }
    <div class="col-md-5">
        <select name="categoryId" class="form-select">
            <option value="">All categories</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId ? "selected" : null)">@cat.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-primary w-100" type="submit">Filter</button>
    </div>
</form>

@if (showTimeline)
{
    @* ---------------- Timeline rendering ---------------- *@
    <div class="timeline">
        @foreach (var a in Model.Items)
        {
            <div class="timeline-item">
                <div class="timeline-date">@a.PublishedAt.ToString("MMMM d, yyyy") · @a.Category.Name</div>
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 card-title">
                            <a asp-action="Details" asp-route-id="@a.ArticleId" class="text-reset">@a.Title</a>
                        </h2>
                        <p class="text-muted small mb-1">
                            @{
                                var plain = System.Net.WebUtility.HtmlDecode(
                                    System.Text.RegularExpressions.Regex.Replace(a.Body, "<.*?>", "")).Trim();
                                var excerpt = plain.Length > 160 ? plain[..160] + "…" : plain;
                            }
                            @excerpt
                        </p>
                        <a asp-action="Details" asp-route-id="@a.ArticleId" class="btn btn-sm btn-outline-primary">Read story ▸</a>
                    </div>
                </div>
            </div>
        }
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state">No timeline stories published yet.</div>
        }
    </div>
}
else
{
    @* ---------------- News card grid ---------------- *@
    <div class="row g-3">
        @foreach (var a in Model.Items)
        {
            <div class="col-md-4">
                <div class="card content-card border-0 shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-primary rounded-pill">@a.Category.Name</span>
                            @if (a.IsTimeline)
                            {
                                <span class="badge bg-secondary rounded-pill">🕰 Timeline</span>
                            }
                        </div>
                        <h2 class="h6 card-title">
                            <a asp-action="Details" asp-route-id="@a.ArticleId" class="text-reset">@a.Title</a>
                        </h2>
                        <div class="small text-muted mb-2">
                            @a.PublishedAt.ToString("MMM d, yyyy")@(a.Author is null ? "" : " · ✍ " + a.Author.Name)
                        </div>
                        <a asp-action="Details" asp-route-id="@a.ArticleId"
                           class="btn btn-sm btn-outline-primary mt-auto align-self-start">Read more ▸</a>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">No articles found for this filter.</div>
    }
}
