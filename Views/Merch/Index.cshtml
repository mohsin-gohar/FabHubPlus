@model MerchViewModel
@{
    ViewData["Title"] = "Merchandise";
}

<partial name="_Breadcrumbs" model="new List<BreadcrumbItem> { new(\"Merchandise\") }" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
    <h1 class="page-title h3 mb-0">🛍 Merchandise showcase</h1>
    <span class="badge bg-info text-dark rounded-pill">Display only — no payments</span>
</div>
<p class="text-muted small mb-3">Limited editions, pre-orders and collectibles from your favourite fandoms.</p>

<form method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">Tag</label>
                <select name="tag" class="form-select">
                    <option value="">All tags</option>
                    @foreach (var t in Enum.GetValues<MerchTag>())
                    {
                        <option value="@t" selected="@(Model.Tag == t ? "selected" : null)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small">Category</label>
                <select name="categoryId" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId ? "selected" : null)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="upcoming" value="true" id="upCheck"
                           checked="@(Model.Upcoming == true ? "checked" : null)" />
                    <label class="form-check-label small" for="upCheck">Upcoming only</label>
                </div>
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-primary" type="submit">Filter</button>
            </div>
        </div>
    </div>
</form>

<div class="row g-3">
    @foreach (var m in Model.Items)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <a asp-action="Details" asp-route-id="@m.ItemId"
               class="card content-card border-0 shadow-sm text-decoration-none h-100">
                @if (!string.IsNullOrEmpty(m.ImageUrl))
                {
                    <img src="@m.ImageUrl" class="card-img-top" alt="@m.Name" />
                }
                else
                {
                    <div class="cover-fallback">🛍 @m.Name</div>
                }
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h2 class="h6 card-title mb-1">@m.Name</h2>
                        @if (m.Tag != MerchTag.None)
                        {
                            <span class="badge bg-warning text-dark rounded-pill">@m.Tag</span>
                        }
                    </div>
                    <div class="small text-muted">@m.Category.Name</div>
                    @if (m.IsUpcoming)
                    {
                        <div class="small text-primary mt-1">
                            🚀 Upcoming @(m.ReleaseDate is not null ? "· " + m.ReleaseDate.Value.ToString("MMM d, yyyy") : "")
                        </div>
                    }
                </div>
            </a>
        </div>
    }
</div>

@if (Model.Items.Count == 0)
{
    <div class="empty-state">
        <div style="font-size:3rem;">🛒</div>
        <p>No merchandise matches these filters.</p>
    </div>
}
