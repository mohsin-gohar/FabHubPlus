                </div>
                <div>
                    <h3 class="mb-[20px] md:mb-[25px] lg:mb-[30px] text-base md:text-lg lg:text-xl leading-none">
                        Explore
                    </h3>
                    <ul class="text-body/80 font-bold text-13 md:text-sm lg:text-15 ltr:md:border-l rtl:md:border-r md:border-white/10 ltr:md:pl-[20px] rtl:md:pr-[20px]">
                        <li class="mb-[13px] md:mb-[15px] last:mb-0">
                            <a asp-controller="Explore" asp-action="Index" class="transition-all ease-in-out duration-300 hover:text-secondary">All content</a>
                        </li>
