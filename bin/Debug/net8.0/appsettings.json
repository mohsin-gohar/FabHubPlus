{
  // NOTE: change the server name if you use SQL Server Express:
  //   Server=.\\SQLEXPRESS;   or a named instance: Server=.\\SQLEXPRESS;InstanceName=...
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MssqlLocalDB;Database=FanHubPlus;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  // E-mail delivery for welcome / password-reset mails.
  // Enabled=false => mails are printed to the console log (great for demos without SMTP).
  // For real delivery set e.g. Gmail: smtp.gmail.com, port 587, EnableSsl=true,
  // User = your address, Password = an app-specific password.
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "From": "no-reply@fanhubplus.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
