@* Reusable content card used by Home + Explorer grids *@
@model FanHubPlus.Models.Entities.Content
<div class="card content-card h-100 border-0 shadow-sm">
    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
    {
        <img src="@Model.ThumbnailUrl" class="card-img-top" alt="@Model.Title" />
    }
    else
    {
        <div class="cover-fallback">@Model.Title</div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <span class="badge badge-type rounded-pill">@Model.Type</span>
            <span class="badge bg-dark rounded-pill view-badge">👁 @Model.ViewCount</span>
        </div>
        <h6 class="card-title mt-1 mb-1">
            <a asp-controller="Explore" asp-action="Details" asp-route-id="@Model.ContentId" class="text-reset">@Model.Title</a>
        </h6>
        <div class="small text-muted mb-2">
            @Model.Category.Name@(Model.Genre is { Length: > 0 } ? " · " + Model.Genre : "")
        </div>
        <p class="small text-muted flex-grow-1 mb-2">
            @((Model.Description ?? "").Length > 90 ? Model.Description[..90] + "…" : Model.Description)
        </p>
        <a asp-controller="Explore" asp-action="Details" asp-route-id="@Model.ContentId"
           class="btn btn-sm btn-outline-primary mt-auto">Open ▸</a>
    </div>
</div>
