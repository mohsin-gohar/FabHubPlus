@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="row g-4">
    @* ---------------- Profile + display settings ---------------- *@
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h1 class="h4 page-title mb-3">⚙️ Profile &amp; display settings</h1>

                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(Model.CurrentAvatarUrl))
                        {
                            <img src="@Model.CurrentAvatarUrl" alt="avatar" class="avatar" style="width:64px;height:64px;" />
                        }
                        else
                        {
                            <span class="avatar" style="width:64px;height:64px;font-size:1.5rem;">
                                @((User.Identity?.Name ?? "?")[..1].ToUpperInvariant())
                            </span>
                        }
                        <div class="flex-grow-1">
                            <label asp-for="AvatarFile" class="form-label small"></label>
                            <input asp-for="AvatarFile" class="form-control form-control-sm" />
                            <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="FontSize" class="form-label"></label>
                            <select asp-for="FontSize" class="form-select"
                                    asp-items="Enumerable.Range(14, 9).Select(i => new SelectListItem(i.ToString(), i.ToString()))">
                            </select>
                        </div>
                        <div class="col-sm-6 d-flex align-items-end">
                            <div class="form-check form-switch">
                                <input asp-for="DarkMode" class="form-check-input" />
                                <label asp-for="DarkMode" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <fieldset class="mb-3">
                        <legend class="form-label">Favorite fandoms</legend>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var cat in Model.AllCategories)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="FavoriteCategoryIds" value="@cat.CategoryId"
                                           id="fav_@cat.CategoryId"
                                           checked="@(Model.FavoriteCategoryIds.Contains(cat.CategoryId) ? "checked" : null)" />
                                    <label class="form-check-label" for="fav_@cat.CategoryId">@cat.Name</label>
                                </div>
                            }
                        </div>
                    </fieldset>

                    <button type="submit" class="btn btn-primary">Save profile</button>
                </form>
            </div>
        </div>
    </div>

    @* ---------------- Change password ---------------- *@
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">🔒 Change password</h2>
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="OldPassword" class="form-label"></label>
                        <input asp-for="OldPassword" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-outline-primary w-100">Change password</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
