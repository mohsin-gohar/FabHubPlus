@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1 page-title">Welcome back 👋</h1>
                <p class="text-muted small mb-3">Sign in to rate, bookmark and submit fan art.</p>

                @if (TempData["StatusMessage"] is string msg)
                {
                    <div class="alert alert-success py-2">@msg</div>
                }
                @if (TempData["ForgotStatus"] is string status)
                {
                    <div class="alert alert-info py-2">@status</div>
                }
                @if (TempData["EmailPreviewLink"] is string link)
                {
                    <div class="alert alert-warning py-2 small">
                        <strong>📧 SMTP is disabled — password reset link (demo):</strong><br />
                        <a href="@link">@link</a>
                    </div>
                }

                <form asp-action="Login" method="post" autocomplete="on">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mb-2">Sign in</button>
                </form>

                @* Forgot-password mini-form (posts to Account/ForgotPassword) *@
                <form asp-action="ForgotPassword" method="post" class="mb-2">
                    @Html.AntiForgeryToken()
                    <div class="input-group input-group-sm">
                        <input type="email" name="Email" class="form-control" placeholder="E-mail for password reset" required />
                        <button class="btn btn-outline-secondary" type="submit">Reset link</button>
                    </div>
                </form>

                <div class="small text-center text-muted">
                    New here? <a asp-action="Register">Create an account</a>
                </div>
                <div class="small text-center text-muted mt-1">
                    Demo: user@fanhubplus.com / User@123 · admin@fanhubplus.com / Admin@123
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
