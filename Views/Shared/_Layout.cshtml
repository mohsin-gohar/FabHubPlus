                    <span class="font-secondary !font-extrabold uppercase tracking-[0.1em] fhp-logo-lg text-white leading-none">
                        Fan<span class="text-secondary">Hub</span>Plus
                    </span>
                </a>
                <p class="flex-none mt-[15px] md:mt-0">
                    Copyright <span class="text-secondary font-bold">FanHubPlus</span> © @DateTime.Now.Year — all rights reserved, built for the TechWiz competition on the
                    <a href="https://envytheme.com/" class="text-secondary font-bold transition-all ease-in-out duration-300 hover:text-primary" target="_blank" rel="noopener">Misao</a> theme.
                </p>
                <p class="flex-none mt-[15px] md:mt-0">
                    <a asp-controller="Sitemap" asp-action="Index" class="transition-all ease-in-out duration-300 hover:text-secondary">Sitemap</a>
