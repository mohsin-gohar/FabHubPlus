                <li class="nav-item mb-[20px] last:mb-0">
                    <a asp-controller="Home" asp-action="Index" class="@SideLink("home")">Home</a>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a asp-controller="Explore" asp-action="Index" class="@SideLink("explore")">Explore content</a>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a asp-controller="Characters" asp-action="Index" class="@SideLink("characters")">Characters</a>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a asp-controller="News" asp-action="Index" class="@SideLink("news")">News &amp; timeline</a>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a asp-controller="Events" asp-action="Index" class="@SideLink("events")">Events</a>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a asp-controller="Merch" asp-action="Index" class="@SideLink("merch")">Merchandise</a>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a asp-controller="FanArt" asp-action="Index" class="@SideLink("fanart")">Fan art gallery</a>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a asp-controller="Chatbot" asp-action="Index" class="@SideLink("chatbot")">Chatbot</a>
                </li>
                <li class="nav-item mb-[20px] last:mb-0">
                    <a asp-controller="Support" asp-action="Index" class="@SideLink("support")">Support &amp; FAQ</a>
                </li>
                <li class="nav-item last:mb-0">
                    <a asp-controller="Sitemap" asp-action="Index" class="@SideLink("sitemap")">Sitemap</a>
                </li>
            </ul>

            <div class="p-[20px] md:p-[30px] lg:px-[40px] fhp-side-foot border-t border-white/8">
                @if (isAuth)
                {
                    <p class="text-13 uppercase font-bold tracking-[0.1em] text-body/70 mb-[15px]">
                        Signed in as @userName
                    </p>
                    <a asp-controller="Bookmarks" asp-action="Index" class="primary-btn block w-full mb-[15px]">
                        <span><i class="ri-heart-3-line"></i> My bookmarks</span>
                    </a>
                    @if (isAdmin)
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="primary-btn with-border block w-full mb-[15px]">
                            Admin dashboard
                        </a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="primary-btn with-border block w-full">Sign out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="primary-btn block w-full mb-[15px]">
                        <span>Sign In</span>
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="primary-btn with-border block w-full">
                        Create account
                    </a>
                }
            </div>
        </div>
    </div>
    <div class="backdrop"></div>
    <!-- End Sidebar Modal -->

    <!-- Main content -->
    <main class="flex-1 fhp-main">
        <div class="container">
            <partial name="_Alerts" />
        </div>
