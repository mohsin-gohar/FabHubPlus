@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

@* ---------- Hero ---------- *@
<section class="hero row align-items-center g-4">
    <div class="col-lg-8">
        <h1 class="display-5 mb-2">Your universe of fandoms, all in one place.</h1>
        <p class="lead mb-3">
            Explore movies, series, games, anime and K-pop. Rate what you love, bookmark your watchlist,
            follow events on the map and share your fan art with the world.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Explore" asp-action="Index" class="btn btn-light btn-lg px-4">🚀 Start exploring</a>
            <a asp-controller="FanArt" asp-action="Index" class="btn btn-outline-light btn-lg px-4">🎨 Fan art gallery</a>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="row g-2 text-center">
            <div class="col-4">
                <div class="stat-card"><div class="stat-value text-primary">@Model.TotalContents</div><div class="stat-label">Titles</div></div>
            </div>
            <div class="col-4">
                <div class="stat-card"><div class="stat-value text-success">@Model.TotalMembers</div><div class="stat-label">Members</div></div>
            </div>
            <div class="col-4">
                <div class="stat-card"><div class="stat-value text-danger">@Model.TotalEvents</div><div class="stat-label">Events</div></div>
            </div>
        </div>
    </div>
</section>

@* ---------- Fandom categories ---------- *@
<section class="mb-5">
    <h2 class="section-title h4 mb-3">Browse by fandom</h2>
    <div class="row g-3">
        @foreach (var cat in Model.Categories)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <a asp-controller="Explore" asp-action="Index" asp-route-categoryId="@cat.CategoryId"
                   class="card content-card border-0 shadow-sm text-decoration-none h-100">
                    <div class="card-body">
                        <div class="fw-bold">@cat.Name</div>
                        <div class="small text-muted">@(cat.Description?.Length > 60 ? cat.Description[..60] + "…" : cat.Description)</div>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

@* ---------- Trending ---------- *@
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title h4 mb-0">🔥 Trending now</h2>
        <a asp-controller="Explore" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a>
    </div>
    <div class="row g-3">
        @foreach (var item in Model.Trending)
        {
            <div class="col-6 col-md-4">
                <partial name="_ContentCard" model="item" />
            </div>
        }
        @if (Model.Trending.Count == 0)
        {
            <div class="col-12"><div class="empty-state">No content yet — check back soon!</div></div>
        }
    </div>
</section>

<div class="row g-4 mb-5">
    @* ---------- Latest news ---------- *@
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="section-title h4 mb-0">📰 Latest news</h2>
            <a asp-controller="News" asp-action="Index" class="btn btn-sm btn-outline-primary">All news</a>
        </div>
        <div class="list-group shadow-sm">
            @foreach (var a in Model.LatestArticles)
            {
                <a asp-controller="News" asp-action="Details" asp-route-id="@a.ArticleId"
                   class="list-group-item list-group-item-action py-3">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1">@a.Title</h6>
                        <small class="text-muted">@a.PublishedAt.ToString("MMM d, yyyy")</small>
                    </div>
                    <small class="text-muted">@a.Category.Name @(a.IsTimeline ? "· 🕰 Timeline" : "")</small>
                </a>
            }
            @if (Model.LatestArticles.Count == 0)
            {
                <div class="list-group-item empty-state">No articles published yet.</div>
            }
        </div>
    </div>

    @* ---------- Upcoming events ---------- *@
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="section-title h4 mb-0">📅 Upcoming events</h2>
            <a asp-controller="Events" asp-action="Index" class="btn btn-sm btn-outline-primary">Map &amp; calendar</a>
        </div>
        <div class="list-group shadow-sm">
            @foreach (var e in Model.UpcomingEvents)
            {
                <div class="list-group-item py-3">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1">@e.Title</h6>
                        <span class="badge bg-primary rounded-pill">@e.EventDate.ToString("MMM d")</span>
                    </div>
                    <small class="text-muted">📍 @e.City @(e.Type is { Length: > 0 } ? "· " + e.Type : "")</small>
                </div>
            }
            @if (Model.UpcomingEvents.Count == 0)
            {
                <div class="list-group-item empty-state">No upcoming events scheduled.</div>
            }
        </div>
    </div>
</div>

@* ---------- Featured merch ---------- *@
<section class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title h4 mb-0">🛍 Featured merchandise</h2>
        <a asp-controller="Merch" asp-action="Index" class="btn btn-sm btn-outline-primary">Browse all</a>
    </div>
    <div class="row g-3">
        @foreach (var m in Model.FeaturedMerch)
        {
            <div class="col-6 col-md-3">
                <a asp-controller="Merch" asp-action="Details" asp-route-id="@m.ItemId"
                   class="card content-card border-0 shadow-sm text-decoration-none h-100">
                    @if (!string.IsNullOrEmpty(m.ImageUrl))
                    {
                        <img src="@m.ImageUrl" class="card-img-top" alt="@m.Name" style="height:160px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="cover-fallback" style="height:160px;">🛍</div>
                    }
                    <div class="card-body py-2">
                        <div class="fw-semibold small">@m.Name</div>
                        <span class="badge bg-secondary rounded-pill">@m.Tag</span>
                    </div>
                </a>
            </div>
        }
        @if (Model.FeaturedMerch.Count == 0)
        {
            <div class="col-12"><div class="empty-state">Merchandise showcase is being stocked.</div></div>
        }
    </div>
</section>

