@* Page banner - the signature Misao "inner page" header.
   Model: breadcrumb trail; the LAST item is the current page.
   Example:
     ViewData["fhpBanner"] = true;
     <partial name="_PageBanner" model="new List<BreadcrumbItem> { new("Explore", "/Explore"), new("Drama") }" /> *@
@model List<FanHubPlus.Models.ViewModels.BreadcrumbItem>
@{
    var trail = Model ?? new List<FanHubPlus.Models.ViewModels.BreadcrumbItem>();
    var current = trail.Count > 0 ? trail[^1].Text : string.Empty;
}
<section class="fhp-banner">
    <div class="container">
        <h1 class="fhp-banner__title">@current</h1>
        <nav aria-label="Breadcrumb">
            <ol class="fhp-crumbs">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                @for (var i = 0; i < trail.Count; i++)
                {
                    var crumb = trail[i];
                    var isLast = i == trail.Count - 1;
                    if (isLast || string.IsNullOrWhiteSpace(crumb.Url))
                    {
                        <li aria-current="page">@crumb.Text</li>
                    }
                    else
                    {
                        <li><a href="@crumb.Url">@crumb.Text</a></li>
                    }
                }
            </ol>
        </nav>
    </div>
    <div class="fhp-banner__curve" aria-hidden="true"></div>
</section>
