@using System.Text.RegularExpressions
@{
    // The public site always runs the Misao (dark) theme; the cookie still
    // carries the visitor's preferred base font size: "fhp_pref" = "1|16".
    var pref = Context.Request.Cookies["fhp_pref"];
    var fontMatch = Regex.Match(pref ?? "", @"\|(\d+)$");
    var fontPx = fontMatch.Success ? fontMatch.Groups[1].Value : "16";

    var isAuth = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var userName = User.Identity?.Name ?? "";

    var controller = (Context.Request.RouteValues["controller"]?.ToString() ?? "Home").ToLowerInvariant();

    // Class strings are copied verbatim from the Misao template so the
    // compiled Tailwind stylesheet really contains them.
    string NavLink(string name) =>
        "nav-link font-bold text-15 relative py-[30px] xl:py-[40px] block text-white transition-all duration-300 ease-in-out hover:text-secondary"
        + (controller == name ? " active" : "");
    string DropLink(string name) =>
        "nav-link font-bold text-15 relative text-white px-[25px] block transition-all duration-300 ease-in-out hover:text-secondary"
        + (controller == name ? " active" : "");
    string SideLink(string name) =>
        "nav-link font-bold text-15 lg:text-base relative block text-white transition-all duration-300 ease-in-out hover:text-secondary"
        + (controller == name ? " active" : "");
}
<!DOCTYPE html>
<html lang="en" class="dark-mode" data-theme-lock="dark" style="font-size: @(fontPx)px">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")FanHubPlus</title>

    @* ---------- Misao theme stylesheets ---------- *@
    <link rel="stylesheet" href="~/assets/css/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/assets/css/flaticon_misao.css" />
    <link rel="stylesheet" href="~/assets/css/scrollCue.css" />
    <link rel="stylesheet" href="~/assets/css/remixicon.css" />
    <link rel="stylesheet" href="~/assets/css/style.css" />
    @* ---------- Bootstrap (grid + widgets used by the inner views) ---------- *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* ---------- FanHubPlus bridge (Misao palette + overrides) ---------- *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="icon" type="image/png" href="~/assets/images/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com/" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montez&amp;family=Montserrat:ital,wght@0,100..900;1,100..900&amp;family=Play:wght@400;700&amp;display=swap" rel="stylesheet" />

    <script>
        // Apply the stored font-size preference before the first paint.
        (function () {
            try {
                var ls = localStorage.getItem('fhp_pref');
                if (ls) {
                    var p = ls.split('|');
                    document.documentElement.style.fontSize = (parseInt(p[1] || '16', 10)) + 'px';
                }
            } catch (e) { /* ignore */ }
        })();
    </script>
</head>
<body class="min-h-screen flex flex-col">
    <!-- Preloader -->
    <div id="preloader" class="fixed top-0 left-0 right-0 bottom-0 z-[999] bg-black flex items-center justify-center">
        <div class="loader"></div>
    </div>
    <!-- End Preloader -->

    <!-- Header -->
