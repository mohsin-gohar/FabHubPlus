@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var code = ViewBag.StatusCode as int?;
}

<div class="text-center py-5">
    <div style="font-size:4.5rem;">@(code == 404 ? "🧭" : "💥")</div>
    <h1 class="page-title mt-2">
        @(code switch { 404 => "Page not found", 403 => "Access denied", 500 => "Something broke", null => "Oops!", _ => $"Error {code}" })
    </h1>
    <p class="text-muted">
        @(code == 404
            ? "The page you are looking for does not exist or has been moved."
            : "An error occurred while processing your request. Please try again.")
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Back to home</a>
    <a asp-controller="Explore" asp-action="Index" class="btn btn-outline-secondary mt-2">Explore content</a>
</div>

